# .env.example
# NATS
NATS_SERVERS="nats://127.0.0.1:4222"
NATS_TOKEN=

# Postgres
DATABASE_URL=

# Mailgun
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=
MAILGUN_MAILING_LIST=

# Discord Server
DISCORD_SERVER_ID=

# Cookie
COOKIE_NAME=

# Fastify
FASTIFY_APP_PATH=
FASTIFY_COOKIE_SECRET=

# Pass variables to Vite
# REMEMBER: VITE_HOST_PROD when testing prod locally
VITE_HOST_PROD=
VITE_HOST_DEV=localhost
VITE_ENABLE_SSL=false

# App Definitions (Capsule Blueprints)
# Absolute path to the directory containing YAML capsule blueprint definitions.
APP_DEFINITIONS_PATH=

# Embedded Worker
QILN_EMBEDDED_WORKER_ENABLED=true

# Experimental Snapshots
# Development and test capsules only. Enables experimental Snapshot Capture
# and snapshot-based editable forks. Production routing remains disabled.
QILN_EXPERIMENTAL_SNAPSHOTS_ENABLED=false

# Incus Configuration
# Use exactly one endpoint URI:
# - unix:///var/snap/incus/common/incus/unix.socket
# - https://incus.runemind.com
INCUS_ENDPOINT=unix:///var/snap/incus/common/incus/unix.socket
INCUS_BASIC_AUTH=
INCUS_REJECT_UNAUTHORIZED=true
INCUS_PROJECT=default
# INCUS_CLIENT_CERT_B64=
# INCUS_CLIENT_KEY_B64=

# Dedicated Qiln routing Caddy administration
# Production uses a permissioned Unix socket injected into the Worker runtime.
# For local development, HTTP is allowed only on loopback, for example through
# an SSH tunnel forwarding the remote admin socket to localhost:2019.
# QILN_CADDY_ENDPOINT=unix:///run/qiln-caddy/admin.sock
QILN_CADDY_ENDPOINT=http://127.0.0.1:2019
QILN_CADDY_SERVER=qiln
QILN_CADDY_FALLBACK_ID=qiln-route-fallback-experimental
QILN_CADDY_REQUEST_TIMEOUT_MS=15000

# Qiln-generated experimental preview hostnames use:
# preview-<branch-id>-<application-hash>.<base-domain>
QILN_ROUTE_BASE_DOMAIN=edge.qiln.com
# Local Caddy listener used by the Worker for end-to-end route verification.
# Verification connects to loopback and supplies the preview hostname through
# the HTTP Host header.
QILN_ROUTING_INGRESS_ENDPOINT=http://127.0.0.1:8080
QILN_PREVIEW_RECONCILE_INTERVAL_MS=15000
QILN_PREVIEW_VERIFICATION_TIMEOUT_MS=10000
