# .env.example
# NATS
NATS_SERVERS="nats://127.0.0.1:4222"
NATS_TOKEN=

# Postgres
DATABASE_URL=

# Mailgun
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=
MAILGUN_MAILING_LIST=

# Discord Server
DISCORD_SERVER_ID=

# Cookie
COOKIE_NAME=

# Fastify
FASTIFY_APP_PATH=
FASTIFY_COOKIE_SECRET=

# Pass variables to Vite
# REMEMBER: VITE_HOST_PROD when testing prod locally
VITE_HOST_PROD=
VITE_HOST_DEV=localhost
VITE_ENABLE_SSL=false

# App Definitions (Capsule Blueprints)
# Absolute path to the directory containing YAML capsule blueprint definitions.
APP_DEFINITIONS_PATH=

# Embedded Worker
QILN_EMBEDDED_WORKER_ENABLED=true

# Experimental Snapshots
# Development and test capsules only. Enables experimental Snapshot Capture
# and snapshot-based editable forks. Production routing remains disabled.
QILN_EXPERIMENTAL_SNAPSHOTS_ENABLED=false

# Incus Configuration (Hybrid Transport)
# Option A: Local Unix Socket
INCUS_SOCKET_PATH=

# Option B: Network mTLS (Overrides socket if INCUS_URL is provided)
INCUS_URL=https://incus.runemind.com
INCUS_AUTH_TOKEN=admin:your_plaintext_password
INCUS_REJECT_UNAUTHORIZED=true
# INCUS_CLIENT_CERT_B64=
# INCUS_CLIENT_KEY_B64=