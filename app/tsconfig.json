{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "lib": ["DOM", "ESNext"],
    "types": ["vite/client", "@types/dom-webcodecs", "@types/node"],
    "paths": {
      "@/*": ["./*"],
      "@server/*": ["./server/*"]
    }
  },
  "include": [
    "./vite.config.ts",
    "./*.d.ts",
    "./types/**/*.ts",
    "./types/**/*.d.ts",
    "./pages/**/*.ts",
    "./pages/**/*.vue",
    "./components/**/*.ts",
    "./components/**/*.vue",
    "./renderer/**/*.ts",
    "./renderer/**/*.vue",
    "./store/**/*.ts",
    "./composables/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "server"]
}
