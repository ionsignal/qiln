{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "rootDir": "./",
    "outDir": "../dist/server",
    "lib": ["es2025"],
    "types": ["node"],
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "incremental": true,
    "paths": {
      "@/*": ["../*"],
      "@server/*": ["./*"]
    }
  },
  "tsc-alias": {
    "verbose": true
  },
  "include": ["./**/*.ts", "../types/**/*.d.ts"],
  "exclude": ["node_modules"]
}
