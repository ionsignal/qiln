{
  "name": "@qiln/mcp",
  "version": "0.1.2",
  "type": "module",
  "bin": {
    "qiln-mcp": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch --mode development",
    "type:check": "tsc --project tsconfig.source.json"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "source": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@qiln/agent": "*"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vite-plugin-dts": "5.1.2"
  }
}
