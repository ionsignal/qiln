    "undici": "8.10.0",
    "ws": "8.21.3",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/ws": "8.18.1",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vite-plugin-dts": "5.0.3"
  }
