{
  "name": "@qiln/agent",
  "version": "0.1.2",
  "type": "module",
  "bin": {
    "qiln": "./dist/cli.js"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch --mode development",
    "type:check": "tsc --project tsconfig.source.json"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "source": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "dependencies": {
    "@qiln/core": "*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vite-plugin-dts": "5.0.3"
  }
}