{
  "mcpServers": {
    "qiln": {
      "command": "node",
      "args": [
        "packages/mcp/dist/cli.js"
      ],
      "cwd": "${QILN_WORKING_DIRECTORY}",
      "env": {
        "QILN_AGENT_URL": "${QILN_AGENT_URL}",
        "QILN_AGENT_KEY": "${QILN_AGENT_KEY}"
      },
      "protocolVersion": "2026-07-28",
      "lifecycle": "eager"
    },
    "githits": {
      "url": "https://mcp.githits.com",
      "auth": "bearer",
      "bearerTokenEnv": "GITHITS_API_TOKEN",
      "lifecycle": "eager"
    }
  }
}
