{
  "compilerOptions": {
    "strict": true,
    "moduleResolution": "bundler",
    "target": "ES2025",
    "types": ["vite/client", "@types/dom-webcodecs", "@types/node", "./types"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "inlineSources": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@/*": ["./*"],
      "@server/*": ["./server/*"],
      "@qiln/core": ["./packages/core/src/index.ts"],
      "@qiln/core/*": ["./packages/core/src/*"],
      "@qiln/engine": ["./packages/engine/src/index.ts"],
      "@qiln/engine/*": ["./packages/engine/src/*"]
    }
  }
}